{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Extension: Watch",
      "type": "shell",
      "command": "pnpm dev",
      "problemMatcher": {
        "owner": "tsup",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Build start",
          "endsPattern": "Build success"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
