{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES2022",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "Node",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node", "vscode"]
	},
	"include": ["src"],
	"exclude": ["node_modules", ".vscode-test"]
}
