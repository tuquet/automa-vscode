{
  "name": "automa-vscode",
  "publisher": "NguyenDinhTu",
  "displayName": "Automa CLI Toolkit",
  "description": "VS Code integration for the Automa Ecosystem CLI",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuquet/automa-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "menus": {
      "explorer/context": [
        {
          "command": "automa.runWorkflow",
          "when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
          "group": "automa@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "automa.runWorkflow",
          "when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "automa.showWorkflowSource",
          "when": "activeCustomEditorId == 'automa.workflowPreview'",
          "group": "navigation"
        },
        {
          "command": "automa.showWorkflowPreview",
          "when": "resourceFilename =~ /automa.json/ && activeCustomEditorId != 'automa.workflowPreview'",
          "group": "navigation"
        },
        {
          "command": "automa.showLogSource",
          "when": "activeCustomEditorId == 'automa.logEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.showLogPreview",
          "when": "resourceFilename =~ /automa-log.json/ && activeCustomEditorId != 'automa.logEditor'",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "automa.showWorkflowPreview",
          "when": "resourceFilename =~ /automa.json/ && activeCustomEditorId != 'automa.workflowPreview'",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "automa.showWorkflowSource",
        "title": "Show Workflow Source",
        "icon": "$(code)"
      },
      {
        "command": "automa.showWorkflowPreview",
        "title": "Preview Workflow",
        "icon": "$(preview)"
      },
      {
        "command": "automa.runWorkflow",
        "title": "Automa: Run Workflow",
        "icon": "$(play)"
      },
      {
        "command": "automa.showLogSource",
        "title": "Show Source",
        "icon": "$(code)"
      },
      {
        "command": "automa.showLogPreview",
        "title": "Open Preview",
        "icon": "$(preview)"
      },
      {
        "command": "automa.openInStudio",
        "title": "Open in Studio",
        "icon": "$(link-external)"
      }
    ],
    "customEditors": [
      {
        "viewType": "automa.logEditor",
        "displayName": "Automa Execution Log",
        "selector": [
          {
            "filenamePattern": "*.automa-log.json"
          }
        ]
      },
      {
        "viewType": "automa.workflowPreview",
        "displayName": "Automa Workflow Preview",
        "selector": [
          {
            "filenamePattern": "*.automa.json"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Automa",
      "properties": {
        "automa.run.useDefaultParameters": {
          "type": "boolean",
          "default": false,
          "description": "Skip interactive prompts for workflow trigger parameters and always use default values."
        },
        "automa.preview.defaultOnClick": {
          "type": "boolean",
          "default": true,
          "description": "Set Automa Workflow Preview as the default editor when clicking on *.automa.json files."
        },
        "automa.vault.run.defaultBrowser": {
          "type": "string",
          "enum": ["chrome", "edge", "firefox", "brave", "active-tab"],
          "default": "chrome",
          "description": "Default browser to use when running a workflow in the Vault."
        },
        "automa.vault.run.headless": {
          "type": "boolean",
          "default": false,
          "description": "Run the browser in headless mode."
        },
        "automa.vault.run.closeBrowserOnFinish": {
          "type": "boolean",
          "default": false,
          "description": "Automatically close the browser when the workflow finishes."
        },
        "automa.vault.run.globalVariables": {
          "type": "object",
          "default": {},
          "description": "Global variables (JSON object) appended to the workflow run parameters."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsup src/extension.ts --format cjs --external vscode --sourcemap",
    "watch": "tsup src/extension.ts --format cjs --external vscode --watch --sourcemap",
    "package": "tsup src/extension.ts --format cjs --external vscode --minify --sourcemap",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
