{
	"name": "automa-vscode",
	"publisher": "NguyenDinhTu",
	"displayName": "Automa CLI Toolkit",
	"description": "VS Code integration for the Automa Ecosystem CLI",
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/tuquet/automa-vscode.git"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"menus": {
			"explorer/context": [
				{
					"submenu": "automa.explorerSubmenu",
					"when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
					"group": "automa@1"
				}
			],
			"automa.explorerSubmenu": [
				{
					"command": "automa.runWorkflow",
					"when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
					"group": "1_run@1"
				},
				{
					"command": "automa.runWorkflowWithParams",
					"when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
					"group": "1_run@2"
				},
				{
					"command": "automa.runFleet",
					"when": "resourceExtname == .json && resourceFilename =~ /.*\\.(fleet|fleets)\\.json$/",
					"group": "1_run@3"
				},
				{
					"command": "automa.stopFleet",
					"when": "resourceExtname == .json && resourceFilename =~ /.*\\.(fleet|fleets)\\.json$/",
					"group": "1_run@3_1"
				},
				{
					"command": "automa.openInStudio",
					"when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
					"group": "1_run@4"
				},
				{
					"command": "automa.fixWorkflowId",
					"when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
					"group": "2_tools@1"
				},
				{
					"command": "automa.lintCheck",
					"when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
					"group": "2_tools@2"
				}
			],
			"editor/title/run": [
				{
					"command": "automa.runWorkflow",
					"when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
					"group": "navigation"
				},
				{
					"command": "automa.runWorkflowWithParams",
					"when": "resourceExtname == .json && resourceFilename =~ /^(?!.*automa-log).*$/",
					"group": "navigation"
				},
				{
					"command": "automa.runFleet",
					"when": "resourceExtname == .json && resourceFilename =~ /.*\\.(fleet|fleets)\\.json$/",
					"group": "navigation"
				},
				{
					"command": "automa.stopFleet",
					"when": "resourceExtname == .json && resourceFilename =~ /.*\\.(fleet|fleets)\\.json$/",
					"group": "navigation"
				}
			],
			"editor/title": [
				{
					"command": "automa.showWorkflowSource",
					"when": "activeCustomEditorId == 'automa.workflowPreview'",
					"group": "navigation"
				},
				{
					"command": "automa.showWorkflowPreview",
					"when": "resourceFilename =~ /\\.(workflow|package)\\.json/ && activeCustomEditorId != 'automa.workflowPreview'",
					"group": "navigation"
				},
				{
					"command": "automa.showFleetSource",
					"when": "activeCustomEditorId == 'automa.fleetPreview'",
					"group": "navigation"
				},
				{
					"command": "automa.showFleetPreview",
					"when": "resourceExtname == .json && resourceFilename =~ /.*\\.(fleet|fleets)\\.json$/ && activeCustomEditorId != 'automa.fleetPreview'",
					"group": "navigation"
				},
				{
					"command": "automa.showLogSource",
					"when": "activeCustomEditorId == 'automa.logEditor'",
					"group": "navigation"
				},
				{
					"command": "automa.showLogPreview",
					"when": "resourceFilename =~ /automa-log.json/ && activeCustomEditorId != 'automa.logEditor'",
					"group": "navigation"
				}
			],
			"editor/title/context": [
				{
					"command": "automa.showWorkflowPreview",
					"when": "resourceFilename =~ /\\.(workflow|package)\\.json/ && activeCustomEditorId != 'automa.workflowPreview'",
					"group": "navigation"
				},
				{
					"command": "automa.showFleetPreview",
					"when": "resourceExtname == .json && resourceFilename =~ /.*\\.(fleet|fleets)\\.json$/ && activeCustomEditorId != 'automa.fleetPreview'",
					"group": "navigation"
				}
			],
			"view/title": [
				{
					"command": "automa.refreshRunners",
					"when": "view == automa.activeRunners",
					"group": "navigation"
				},
				{
					"command": "automa.refreshHistory",
					"when": "view == automa.executionHistory",
					"group": "navigation"
				},
				{
					"command": "automa.filterHistoryByTaskId",
					"when": "view == automa.executionHistory",
					"group": "navigation@1"
				},
				{
					"command": "automa.clearHistoryFilter",
					"when": "view == automa.executionHistory && automa.history.isFiltered",
					"group": "navigation@2"
				},
				{
					"command": "automa.clearHistory",
					"when": "view == automa.executionHistory",
					"group": "navigation@3"
				},
				{
					"command": "automa.refreshProfiles",
					"when": "view == automa.browserProfiles",
					"group": "navigation"
				},
				{
					"command": "automa.searchProfiles",
					"when": "view == automa.browserProfiles",
					"group": "navigation@1"
				},
				{
					"command": "automa.createProfile",
					"when": "view == automa.browserProfiles",
					"group": "navigation@0"
				},
				{
					"command": "automa.clearSearchProfiles",
					"when": "view == automa.browserProfiles && automa.browserProfiles.isFiltered",
					"group": "navigation@2"
				},
				{
					"command": "automa.refreshWorkflows",
					"when": "view == automa.workflows",
					"group": "navigation"
				},
				{
					"command": "automa.searchWorkflows",
					"when": "view == automa.workflows",
					"group": "navigation@1"
				},
				{
					"command": "automa.createWorkflow",
					"when": "view == automa.workflows",
					"group": "navigation@0"
				},
				{
					"command": "automa.clearSearchWorkflows",
					"when": "view == automa.workflows && automa.workflows.isFiltered",
					"group": "navigation@2"
				},
				{
					"command": "automa.refreshPackages",
					"when": "view == automa.packages",
					"group": "navigation"
				},
				{
					"command": "automa.searchPackages",
					"when": "view == automa.packages",
					"group": "navigation@1"
				},
				{
					"command": "automa.createPackage",
					"when": "view == automa.packages",
					"group": "navigation@0"
				},
				{
					"command": "automa.clearSearchPackages",
					"when": "view == automa.packages && automa.packages.isFiltered",
					"group": "navigation@2"
				},
				{
					"command": "automa.refreshFleets",
					"when": "view == automa.fleets",
					"group": "navigation"
				},
				{
					"command": "automa.searchFleets",
					"when": "view == automa.fleets",
					"group": "navigation@1"
				},
				{
					"command": "automa.clearSearchFleets",
					"when": "view == automa.fleets && automa.fleets.isFiltered",
					"group": "navigation@2"
				},
				{
					"command": "automa.refreshVault",
					"when": "view == automa.globalVault",
					"group": "navigation@1"
				},
				{
					"command": "automa.addVariable",
					"when": "view == automa.globalVault",
					"group": "navigation@2"
				},
				{
					"command": "automa.addCredential",
					"when": "view == automa.globalVault",
					"group": "navigation@3"
				},
				{
					"command": "automa.addTable",
					"when": "view == automa.globalVault",
					"group": "navigation@4"
				}
			],
			"view/item/context": [
				{
					"command": "automa.killRunner",
					"when": "viewItem == automaRunner",
					"group": "inline"
				},
				{
					"command": "automa.showLiveLog",
					"when": "viewItem == automaRunner",
					"group": "inline"
				},
				{
					"command": "automa.deleteHistoryItem",
					"when": "viewItem == automaHistoryLog",
					"group": "inline"
				},
				{
					"command": "automa.runWorkflow",
					"when": "viewItem == automaFileItem-automa.workflows",
					"group": "inline"
				},
				{
					"command": "automa.runFleet",
					"when": "viewItem == automaFileItem-automa.fleets",
					"group": "inline"
				},
				{
					"command": "automa.stopFleet",
					"when": "viewItem == automaFileItem-automa.fleets",
					"group": "inline"
				},
				{
					"command": "automa.runWorkflowWithParams",
					"when": "viewItem == automaFileItem-automa.workflows",
					"group": "1_run@2"
				},
				{
					"command": "automa.openInStudio",
					"when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
					"group": "1_run@3"
				},
				{
					"command": "automa.fixWorkflowId",
					"when": "viewItem == automaFileItem-automa.workflows",
					"group": "2_tools@1"
				},
				{
					"command": "automa.lintCheck",
					"when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
					"group": "2_tools@2"
				},
				{
					"command": "automa.deleteVaultItem",
					"when": "view == automa.globalVault && (viewItem == Variable || viewItem == Credential || viewItem == Table)",
					"group": "inline"
				}
			]
		},
		"submenus": [
			{
				"id": "automa.explorerSubmenu",
				"label": "Automa Toolkit"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "automa-activity-bar",
					"title": "Automa Ecosystem",
					"icon": "resources/automa-icon.svg"
				}
			]
		},
		"views": {
			"automa-activity-bar": [
				{
					"id": "automa.activeRunners",
					"name": "Active Runners",
					"icon": "assets/icons/rocket.svg",
					"contextualTitle": "Automa Active Runners"
				},
				{
					"id": "automa.executionHistory",
					"name": "Execution History",
					"icon": "assets/icons/rocket.svg",
					"contextualTitle": "Automa Execution History"
				},
				{
					"id": "automa.fleets",
					"name": "Fleets",
					"icon": "$(rocket)",
					"contextualTitle": "Automa Fleets"
				},
				{
					"id": "automa.workflows",
					"name": "Workflows",
					"icon": "$(file-code)",
					"contextualTitle": "Automa Workflows"
				},
				{
					"id": "automa.globalVault",
					"name": "Global Vault",
					"icon": "$(shield)",
					"contextualTitle": "Automa Global Vault"
				},
				{
					"id": "automa.browserProfiles",
					"name": "Profiles",
					"icon": "$(account)",
					"contextualTitle": "Automa Profiles"
				},
				{
					"id": "automa.packages",
					"name": "Packages",
					"icon": "$(package)",
					"contextualTitle": "Automa Packages"
				}
			]
		},
		"languages": [
			{
				"id": "json",
				"extensions": [
					".workflow.json",
					".package.json",
					".profile.json",
					".bprofile.json",
					".variable.json",
					".credential.json",
					".table.json",
					".fleet.json",
					".fleets.json",
					".automa-log.json"
				]
			}
		],
		"commands": [
			{
				"command": "automa.showWorkflowSource",
				"title": "Show Workflow Source",
				"category": "Automa",
				"icon": "$(code)"
			},
			{
				"command": "automa.showWorkflowPreview",
				"title": "Preview Workflow",
				"category": "Automa",
				"icon": "$(preview)"
			},
			{
				"command": "automa.showFleetSource",
				"title": "Show Fleet Source",
				"category": "Automa",
				"icon": "$(code)"
			},
			{
				"command": "automa.showFleetPreview",
				"title": "Preview Fleet",
				"category": "Automa",
				"icon": "$(preview)"
			},
			{
				"command": "automa.runWorkflow",
				"title": "Run Workflow",
				"category": "Automa",
				"icon": "$(play)"
			},
			{
				"command": "automa.runWorkflowWithParams",
				"title": "Run Workflow with Parameters",
				"category": "Automa",
				"icon": "$(play-circle)"
			},
			{
				"command": "automa.runFleet",
				"title": "Run Fleet",
				"category": "Automa",
				"icon": "$(play)"
			},
			{
				"command": "automa.stopFleet",
				"title": "Stop Fleet",
				"category": "Automa",
				"icon": "$(stop)"
			},
			{
				"command": "automa.fixWorkflowId",
				"title": "Auto-Fix Workflow ID",
				"category": "Automa",
				"icon": "$(wrench)"
			},
			{
				"command": "automa.lintCheck",
				"title": "Lint Check Workflow",
				"category": "Automa",
				"icon": "$(checklist)"
			},
			{
				"command": "automa.showLogSource",
				"title": "Show Source",
				"category": "Automa",
				"icon": "$(code)"
			},
			{
				"command": "automa.showLogPreview",
				"title": "Open Preview",
				"category": "Automa",
				"icon": "$(preview)"
			},
			{
				"command": "automa.history.loadMore",
				"title": "Load More...",
				"category": "Automa",
				"icon": "$(sync)"
			},
			{
				"command": "automa.openInStudio",
				"title": "Open in Studio",
				"category": "Automa",
				"icon": "$(link-external)"
			},
			{
				"command": "automa.focusActiveRunners",
				"title": "Focus Active Runners",
				"category": "Automa"
			},
			{
				"command": "automa.createWorkflow",
				"title": "Create Workflow",
				"category": "Automa",
				"icon": "$(add)"
			},
			{
				"command": "automa.createPackage",
				"title": "Create Package",
				"category": "Automa",
				"icon": "$(add)"
			},
			{
				"command": "automa.createProfile",
				"title": "Create Profile",
				"category": "Automa",
				"icon": "$(add)"
			},
			{
				"command": "automa.refreshRunners",
				"title": "Refresh Runners",
				"category": "Automa",
				"icon": "$(refresh)"
			},
			{
				"command": "automa.refreshHistory",
				"title": "Refresh History",
				"category": "Automa",
				"icon": "$(refresh)"
			},
			{
				"command": "automa.refreshProfiles",
				"title": "Refresh Profiles",
				"category": "Automa",
				"icon": "$(refresh)"
			},
			{
				"command": "automa.refreshWorkflows",
				"title": "Refresh Workflows",
				"category": "Automa",
				"icon": "$(refresh)"
			},
			{
				"command": "automa.refreshPackages",
				"title": "Refresh Packages",
				"category": "Automa",
				"icon": "$(refresh)"
			},
			{
				"command": "automa.refreshFleets",
				"title": "Refresh Fleets",
				"category": "Automa",
				"icon": "$(refresh)"
			},
			{
				"command": "automa.deleteHistoryItem",
				"title": "Delete",
				"category": "Automa",
				"icon": "$(trash)"
			},
			{
				"command": "automa.clearHistory",
				"title": "Clear History",
				"category": "Automa",
				"icon": "$(trash)"
			},
			{
				"command": "automa.filterHistoryByTaskId",
				"title": "Filter by Task ID",
				"category": "Automa",
				"icon": "$(filter)"
			},
			{
				"command": "automa.clearHistoryFilter",
				"title": "Clear Filter",
				"category": "Automa",
				"icon": "$(clear-all)"
			},
			{
				"command": "automa.killRunner",
				"title": "Kill Runner",
				"category": "Automa",
				"icon": "$(close)"
			},
			{
				"command": "automa.vault.encryptSecret",
				"title": "Encrypt Secret",
				"category": "Automa Vault"
			},
			{
				"command": "automa.showLiveLog",
				"title": "Live Log",
				"category": "Automa",
				"icon": "$(output)"
			},
			{
				"command": "automa.searchProfiles",
				"title": "Search",
				"category": "Automa",
				"icon": "$(search)"
			},
			{
				"command": "automa.searchWorkflows",
				"title": "Search",
				"category": "Automa",
				"icon": "$(search)"
			},
			{
				"command": "automa.searchPackages",
				"title": "Search",
				"category": "Automa",
				"icon": "$(search)"
			},
			{
				"command": "automa.searchFleets",
				"title": "Search",
				"category": "Automa",
				"icon": "$(search)"
			},
			{
				"command": "automa.clearSearchProfiles",
				"title": "Clear Search",
				"category": "Automa",
				"icon": "$(clear-all)"
			},
			{
				"command": "automa.clearSearchWorkflows",
				"title": "Clear Search",
				"category": "Automa",
				"icon": "$(clear-all)"
			},
			{
				"command": "automa.clearSearchPackages",
				"title": "Clear Search",
				"category": "Automa",
				"icon": "$(clear-all)"
			},
			{
				"command": "automa.clearSearchFleets",
				"title": "Clear Search",
				"category": "Automa",
				"icon": "$(clear-all)"
			},
			{
				"command": "automa.addVariable",
				"title": "Add Variable",
				"category": "Automa Vault",
				"icon": "$(add)"
			},
			{
				"command": "automa.addCredential",
				"title": "Add Credential",
				"category": "Automa Vault",
				"icon": "$(key)"
			},
			{
				"command": "automa.addTable",
				"title": "Add Table",
				"category": "Automa Vault",
				"icon": "$(list-flat)"
			},
			{
				"command": "automa.refreshVault",
				"title": "Refresh",
				"category": "Automa Vault",
				"icon": "$(refresh)"
			},
			{
				"command": "automa.deleteVaultItem",
				"title": "Delete",
				"category": "Automa Vault",
				"icon": "$(trash)"
			},
			{
				"command": "automa.welcome",
				"title": "Show Welcome Guide",
				"category": "Automa",
				"icon": "$(heart)"
			},
			{
				"command": "automa.installBrowser",
				"title": "Install Built-in Browser",
				"category": "Automa",
				"icon": "$(browser)"
			},
			{
				"command": "automa.toggleDaemon",
				"title": "Toggle Background Daemon",
				"category": "Automa",
				"icon": "$(server-environment)"
			}
		],
		"customEditors": [
			{
				"viewType": "automa.logEditor",
				"displayName": "Automa Execution Log",
				"selector": [
					{
						"filenamePattern": "*.automa-log.json"
					}
				]
			},
			{
				"viewType": "automa.workflowPreview",
				"displayName": "Automa Workflow Preview",
				"selector": [
					{
						"filenamePattern": "*.workflow.json"
					},
					{
						"filenamePattern": "*.package.json"
					}
				]
			},
			{
				"viewType": "automa.fleetPreview",
				"displayName": "Fleet Preview",
				"selector": [
					{
						"filenamePattern": "*.fleet.json"
					},
					{
						"filenamePattern": "*.fleets.json"
					}
				]
			},
			{
				"viewType": "automa.bprofileEditor",
				"displayName": "Automa Data Editor",
				"selector": [
					{
						"filenamePattern": "*.profile.json"
					},
					{
						"filenamePattern": "*.bprofile.json"
					},
					{
						"filenamePattern": "*.variable.json"
					},
					{
						"filenamePattern": "*.credential.json"
					},
					{
						"filenamePattern": "*.table.json"
					}
				]
			}
		],
		"configuration": [
			{
				"title": "Automa: Editor & Preview",
				"properties": {
					"automa.preview.defaultOnClick": {
						"type": "boolean",
						"default": true,
						"description": "Set Automa Workflow/Package Preview as the default editor when clicking on *.workflow.json or *.package.json files."
					}
				}
			},
			{
				"title": "Automa: Workflow Execution",
				"properties": {
					"automa.run.useDefaultParameters": {
						"type": "boolean",
						"default": false,
						"description": "Skip interactive prompts for workflow trigger parameters and always use default values."
					},
					"automa.vault.run.defaultBrowser": {
						"type": "string",
						"enum": [
							"chromium",
							"chrome",
							"edge",
							"firefox",
							"brave",
							"active-tab"
						],
						"default": "chromium",
						"description": "Default browser to use when running a workflow in the Vault. 'chromium' uses the isolated built-in browser."
					},
					"automa.vault.run.headless": {
						"type": "boolean",
						"default": false,
						"description": "Run the browser in headless mode."
					},
					"automa.vault.run.closeBrowserOnFinish": {
						"type": "boolean",
						"default": true,
						"description": "Automatically close the browser when the workflow finishes."
					},
					"automa.vault.run.debug": {
						"type": "boolean",
						"default": false,
						"description": "Enable verbose debug logging for CLI execution"
					},
					"automa.vault.run.fleetGridSystem": {
						"type": "boolean",
						"default": true,
						"description": "Enable Grid System to automatically allocate and position browser windows when running Automa Fleet."
					},
					"automa.cliPath": {
						"type": "string",
						"default": "",
						"description": "Absolute path to the automa-cli executable. Leave empty to auto-detect or use npx."
					},
					"automa.daemon.port": {
						"type": "number",
						"default": 8765,
						"description": "Base port for the Automa background daemon. The extension will automatically find the next available port if this one is in use."
					},
					"automa.encryptionPassphrase": {
						"type": "string",
						"default": "",
						"description": "Passphrase used to encrypt credentials in the Automa Global Vault."
					},
					"automa.extensionPaths": {
						"type": "string",
						"default": "",
						"description": "Comma-separated absolute paths to the Automa extensions (e.g. automa-source/build). Leave empty to use CLI default."
					}
				}
			},
			{
				"title": "Automa: Environment & Logs",
				"properties": {
					"automa.vault.run.globalVariables": {
						"type": "object",
						"default": {},
						"description": "Global variables (JSON object) appended to the workflow run parameters.",
						"additionalProperties": {
							"type": "string"
						}
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm run package",
		"compile": "tsup src/extension.ts --format cjs --external vscode --sourcemap",
		"watch": "tsup src/extension.ts --format cjs --external vscode --sourcemap --watch",
		"package": "tsup src/extension.ts --format cjs --external vscode --minify",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "pnpm run compile-tests && pnpm run compile && pnpm run check",
		"check": "biome check --write",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "18.x",
		"@types/vscode": "^1.80.0",
		"tsup": "^8.0.2",
		"typescript": "^5.3.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"leader-line-new": "^1.1.9",
		"sortablejs": "^1.15.7"
	}
}
