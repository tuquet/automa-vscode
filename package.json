{
  "name": "automa-vscode",
  "publisher": "NguyenDinhTu",
  "displayName": "Automa CLI Toolkit",
  "description": "VS Code integration for the Automa Ecosystem CLI",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuquet/automa-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "menus": {
      "explorer/context": [
        {
          "command": "automa.runWorkflow",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "editor/title/run": [
        {
          "command": "automa.runWorkflow",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "automa.previewWorkflow",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "automa.previewWorkflow",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "automa.filterHistory",
          "when": "view == automa.historyView",
          "group": "navigation@1"
        },
        {
          "command": "automa.refreshHistory",
          "when": "view == automa.historyView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "automa.viewLog",
          "when": "view == automa.historyView"
        }
      ]
    },
    "commands": [
      {
        "command": "automa.previewWorkflow",
        "title": "Automa: Preview Workflow",
        "icon": "$(preview)"
      },
      {
        "command": "automa.runWorkflow",
        "title": "Automa: Run Workflow",
        "icon": "$(play)"
      },
      {
        "command": "automa.refreshHistory",
        "title": "Refresh History",
        "icon": "$(refresh)"
      },
      {
        "command": "automa.filterHistory",
        "title": "Filter History",
        "icon": "$(filter)"
      },
      {
        "command": "automa.viewLog",
        "title": "View Execution Log",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "automa-explorer",
          "title": "Automa",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "automa-explorer": [
        {
          "id": "automa.historyView",
          "name": "Execution History",
          "icon": "$(history)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsup src/extension.ts --format cjs --external vscode --sourcemap",
    "watch": "tsup src/extension.ts --format cjs --external vscode --watch --sourcemap",
    "package": "tsup src/extension.ts --format cjs --external vscode --minify --sourcemap",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
